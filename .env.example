# ============================================
# Environment Variables Template
# Copy this file to .env and fill in values
# NEVER commit .env to Git
# ============================================

# Runtime
NODE_ENV=development

# Backend server port
PORT=4000

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL="postgresql://postgres:password@localhost:5432/whiteboard"

# Redis (matches docker-compose defaults)
REDIS_URL="redis://localhost:6379"

# JWT secret — change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-key"

# ============================================
# Frontend variables (NEXT_PUBLIC_ prefix exposes to browser)
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
